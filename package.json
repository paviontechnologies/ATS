{
  "name": "enterprise-ats",
  "version": "1.0.0",
  "type": "module",
  "description": "Full-fledged Enterprise Multi-Tenant AI-Powered Applicant Tracking System (ATS)",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node scripts/startAll.js",
    "start:all": "node scripts/startAll.js",
    "start:core": "PORT=5000 node server/src/index.js",
    "start:admin": "ADMIN_PORT=5001 node server/src/adminServer.js",
    "start:frontend": "CLIENT_PORT=3001 node client/server.js",
    "seed": "node server/src/seed.js",
    "test": "node server/test/runTests.js",
    "ai": "cd ai-service && python3 -m uvicorn app.main:app --reload --port 8000"
  },
  "keywords": ["ats", "recruitment", "ai-matching", "hr-tech", "multi-tenant", "kanban"],
  "author": "Enterprise ATS Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.13.0",
    "zod": "^3.22.4"
  }
}
